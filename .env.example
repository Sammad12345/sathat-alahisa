# Public site URL (used for canonical, Open Graph and structured-data links)
NEXT_PUBLIC_SITE_URL=https://example.sa

# --- Contact form email delivery (SMTP) ---
# Without these, the form shows an honest "not available" message and offers WhatsApp instead.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-character Google App Password, not your normal password>.
SMTP_HOST=
SMTP_PORT=465
# true for port 465 (implicit TLS), false for 587 (STARTTLS). Defaults from the port if omitted.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Inbox that receives service requests
CONTACT_TO_EMAIL=
# Optional sender address (defaults to SMTP_USER; must be allowed by your SMTP provider)
CONTACT_FROM_EMAIL=
